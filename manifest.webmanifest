{
  "name": "Spoonbook",
  "short_name": "Spoonbook",
  "description": "Our shared cookbook: recipes, photos, meal plans and the shopping list.",
  "id": "./",
  "start_url": "./#book",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1F1A17",
  "theme_color": "#1F1A17",
  "categories": ["food", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Shopping list", "url": "./#shopping", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "This week", "url": "./#plan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
